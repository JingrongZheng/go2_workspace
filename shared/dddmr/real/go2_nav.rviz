Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initial_3d_pose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose_3d
    - Class: rviz_default_plugins/PublishPoint
      Topic:
        Value: /clicked_point
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Saved Ground (/map1/mapground)
      Enabled: true
      Color Transformer: FlatColor
      Color: 100; 195; 120
      Size (Pixels): 2
      Topic:
        Value: /map1/mapground
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/PointCloud2
      Name: Saved Surfaces (/map1/mapsurface)
      Enabled: true
      Color Transformer: FlatColor
      Color: 130; 180; 210
      Size (Pixels): 2
      Topic:
        Value: /map1/mapsurface
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/PointCloud2
      Name: Saved Edge Map (/map1/mapcloud)
      Enabled: true
      Color Transformer: FlatColor
      Color: 245; 170; 60
      Size (Pixels): 3
      Topic:
        Value: /map1/mapcloud
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/PointCloud2
      Name: Live Point-LIO Scan (/cloud_registered)
      Enabled: true
      Color Transformer: FlatColor
      Color: 255; 80; 80
      Size (Pixels): 3
      Topic:
        Value: /cloud_registered
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PointCloud2
      Name: Local Obstacles (/perception_3d_local/lidar/current_observation)
      Enabled: true
      Color Transformer: FlatColor
      Color: 255; 0; 255
      Size (Pixels): 4
      Topic:
        Value: /perception_3d_local/lidar/current_observation
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PoseArray
      Name: MCL Particles (/particles)
      Enabled: true
      Color: 255; 230; 50
      Topic:
        Value: /particles
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Robot 3D Cuboid (/robot_cuboid)
      Namespaces:
        edges: true
      Topic:
        Value: /robot_cuboid
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Path
      Name: Global A* Path (/awared_global_path)
      Enabled: true
      Color: 0; 255; 0
      Topic:
        Value: /awared_global_path
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Pruned Local Plan (/prune_plan)
      Enabled: true
      Color: 255; 255; 0
      Topic:
        Value: /prune_plan
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PoseArray
      Name: Local Best Trajectory (/best_trajectory)
      Enabled: true
      Color: 0; 180; 255
      Topic:
        Value: /best_trajectory
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PoseArray
      Name: Local Candidate Trajectories (/trajectory)
      Enabled: false
      Color: 255; 100; 100
      Topic:
        Value: /trajectory
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Name: Global dGraph (/perception_3d_ros/dGraph)
      Enabled: false
      Color Transformer: Intensity
      Size (Pixels): 3
      Topic:
        Value: /perception_3d_ros/dGraph
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF (map -> odom -> base_link)
      Enabled: true
