Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Saved Ground (/map1/mapground)
      Enabled: true
      Color Transformer: FlatColor
      Color: 100; 195; 120
      Size (Pixels): 2
      Topic:
        Value: /map1/mapground
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/PointCloud2
      Name: Saved Surfaces (/map1/mapsurface)
      Enabled: true
      Color Transformer: FlatColor
      Color: 160; 220; 255
      Size (Pixels): 3
      Topic:
        Value: /map1/mapsurface
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/PointCloud2
      Name: Saved Edge Features (/map1/mapcloud)
      Enabled: true
      Color Transformer: FlatColor
      Color: 245; 170; 60
      Size (Pixels): 4
      Topic:
        Value: /map1/mapcloud
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/PoseArray
      Name: Saved Keyframes (/map1/key_poses)
      Enabled: true
      Color: 80; 140; 245
      Topic:
        Value: /map1/key_poses
        Reliability Policy: Reliable
        Durability Policy: Transient Local
