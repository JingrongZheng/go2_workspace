Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: DDDMR edge feature map
      Enabled: true
      Color Transformer: FlatColor
      Color: 240; 170; 60
      Size (Pixels): 3
      Topic:
        Value: /lego_loam_map
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Name: DDDMR accumulated ground
      Enabled: true
      Color Transformer: FlatColor
      Color: 100; 195; 120
      Size (Pixels): 2
      Topic:
        Value: /lego_loam_ground
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Name: Current Point-LIO scan
      Enabled: true
      Color Transformer: FlatColor
      Color: 210; 210; 220
      Size (Pixels): 2
      Topic:
        Value: /cloud_registered
        Reliability Policy: Best Effort
    - Class: rviz_default_plugins/PoseArray
      Name: DDDMR keyframes
      Enabled: true
      Color: 80; 140; 245
      Topic:
        Value: /key_poses
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: Coordinate frames
      Enabled: false
